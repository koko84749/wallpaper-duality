@theme "/usr/share/rofi/themes/android_notification.rasi"

* {
    font: "JetBrainsMonoNL Nerd Font 11";
}

window {
    width: 480px;
}

element {
    padding: 4px;
    orientation: vertical;
}

element-icon {
    padding: 0 0 2px 0;
    size: 2.0em;
}

element-text {
    horizontal-align: 0.5;
}

element selected {
    background: #89b4fa;
    foreground: #1e1e2e;
    text-color: #1e1e2e;
}

element selected element-icon {
    color: #1e1e2e;
}

listview {
    padding: 4px;
    spacing: 2px;
    lines: 6;
    orientation: vertical;
}

mainbox {
    padding: 6px;
}

message {
    background: transparent;
    font: "JetBrainsMonoNL Nerd Font 9";
    padding: 2px 8px;
    text-color: #a6adc8;
}

inputbar {
    padding: 4px;
}
